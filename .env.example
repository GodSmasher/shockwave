# FalkorDB connection
# Free tier: https://app.falkordb.cloud/
FALKORDB_HOST=your-instance.cloud.falkordb.io
FALKORDB_PORT=12345
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your-password-here
FALKORDB_GRAPH=shockwave

# LLM — Nebius AI Studio (OpenAI-compatible)
# Create key at https://studio.nebius.com/settings/api-keys
NEBIUS_API_KEY=your-nebius-key
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Optional — EDGAR scraper (not wired into main app yet)
SEC_USER_AGENT=Your Name your-email@example.com
